{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "price_pounds": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.01
    }
  },
  "required": [
    "effective_date",
    "price_pounds"
  ],
  "additionalProperties": false
}
